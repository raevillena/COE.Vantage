// COE.Vantage - Faculty Load Scheduling System
// PostgreSQL with UUID primary keys

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEAN
  CHAIRMAN
  FACULTY
  OFFICER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role
  departmentId String?
  name         String
  status       String?    // e.g. Full-time, Part-time (from faculty list)
  maxUnits     Int?       // max load units per term (null = no cap)
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyLoads FacultyLoad[]
  subjectFacultyPriorities SubjectFacultyPriority[]
  crossDepartmentRequestsRequested CrossDepartmentLoadRequest[] @relation("RequestedBy")
  crossDepartmentRequestsResponded CrossDepartmentLoadRequest[] @relation("RespondedBy")
  crossDepartmentRequestsAsFaculty CrossDepartmentLoadRequest[] @relation("FacultyRequested")

  @@index([role, departmentId])
  @@index([isDeleted])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String?
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  rooms               Room[]
  roomsControlled     Room[]  @relation("ControlDepartment")
  curricula           Curriculum[]
  subjects            Subject[]
  schedulingRuleSets  SchedulingRuleSet[]
  @@index([isDeleted])
}

model Room {
  id                   String   @id @default(uuid())
  name                 String
  capacity             Int
  hasComputer          Boolean  @default(false)
  isLab                Boolean  @default(false)
  hasAC                Boolean  @default(false)
  departmentId         String
  controlDepartmentId  String?  // department that controls assignment; when closed, only they can assign
  isDeleted            Boolean  @default(false)
  deletedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  department          Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  controlDepartment   Department?  @relation("ControlDepartment", fields: [controlDepartmentId], references: [id], onDelete: SetNull)
  facultyLoads        FacultyLoad[]
  termAvailability    RoomTermAvailability[]
  crossDepartmentLoadRequests CrossDepartmentLoadRequest[]

  @@index([departmentId])
  @@index([departmentId, isLab, capacity])
  @@index([controlDepartmentId])
  @@index([isDeleted])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   // e.g. "2025-2026"
  isActive  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facultyLoads           FacultyLoad[]
  roomTermAvailability   RoomTermAvailability[]
  crossDepartmentRequests CrossDepartmentLoadRequest[]
  schedulingRuleSetAssignments SchedulingRuleSetAssignment[]
  @@index([isDeleted])
}

model Curriculum {
  id           String   @id @default(uuid())
  name         String
  code         String?
  departmentId String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subjects      Subject[]
  studentClasses StudentClass[]
  @@index([isDeleted])
}

model Subject {
  id           String   @id @default(uuid())
  code         String
  name         String
  units        Int
  isLab        Boolean  @default(false)
  yearLevel    Int?     // 1-5
  semester     Int?     // 1 = 1st sem, 2 = 2nd sem, 3 = mid year
  curriculumId String?
  departmentId String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum    Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyLoads  FacultyLoad[]
  subjectFacultyPriorities SubjectFacultyPriority[]
  crossDepartmentLoadRequests CrossDepartmentLoadRequest[]
  @@index([isDeleted])
}

model StudentClass {
  id           String   @id @default(uuid())
  name         String   // e.g. BSCE-3A
  yearLevel    Int
  curriculumId String
  studentCount Int
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  facultyLoads FacultyLoad[]
  crossDepartmentLoadRequests CrossDepartmentLoadRequest[]
  schedulingRuleSetAssignments SchedulingRuleSetAssignment[]

  @@index([curriculumId])
  @@index([isDeleted])
}

// Per-term room availability: closed = only control dept can assign; open = any dept
model RoomTermAvailability {
  id              String   @id @default(uuid())
  roomId          String
  academicYearId  String
  semester        Int      // 1 or 2
  isOpen          Boolean  @default(false) // when true, any department can assign
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([roomId, academicYearId, semester])
  @@index([roomId])
  @@index([academicYearId])
}

enum CrossDepartmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Chairman A requests to assign faculty from Dept B; Chairman B approves/rejects
model CrossDepartmentLoadRequest {
  id              String   @id @default(uuid())
  requestedById   String
  facultyId       String
  subjectId       String
  studentClassId  String
  roomId          String?  // nullable for off-system room
  roomDisplayName String?
  dayOfWeek       Int
  startTime       String
  endTime         String
  semester        Int
  academicYearId  String
  status          CrossDepartmentRequestStatus @default(PENDING)
  respondedById   String?
  respondedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requestedBy   User         @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  faculty       User         @relation("FacultyRequested", fields: [facultyId], references: [id], onDelete: Cascade)
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentClass  StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  room          Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  respondedBy   User?        @relation("RespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([academicYearId])
  @@index([status])
}

// dayOfWeek: 1 = Monday, 7 = Saturday (ISO); or 0-6 in some systems - we use 1-7
// startTime/endTime: "HH:mm" e.g. "08:00", "09:30"
// facultyId/roomId optional for "Others" faculty and off-system room; use facultyDisplayName/roomDisplayName when null
model FacultyLoad {
  id                  String   @id @default(uuid())
  facultyId           String?  // null = off-system faculty (use facultyDisplayName)
  facultyDisplayName  String?
  subjectId           String
  studentClassId      String
  roomId              String?  // null = off-system room (use roomDisplayName)
  roomDisplayName     String?
  dayOfWeek           Int      // 1 = Mon .. 7 = Sat (or 0-6; we use 1-7 for display)
  startTime           String   // "HH:mm"
  endTime             String   // "HH:mm"
  semester            Int      // 1 or 2
  academicYearId      String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  faculty      User?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentClass StudentClass  @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([roomId])
  @@index([studentClassId])
  @@index([academicYearId])
  @@index([roomId, dayOfWeek, academicYearId, semester])
  @@index([facultyId, dayOfWeek, academicYearId, semester])
  @@index([studentClassId, dayOfWeek, academicYearId, semester])
}

model SubjectFacultyPriority {
  id         String   @id @default(uuid())
  subjectId  String
  facultyId  String
  priority   Int      @default(0)
  createdAt  DateTime @default(now())

  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty  User    @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([subjectId, facultyId])
  @@index([subjectId])
  @@index([facultyId])
}

// Configurable rule set for auto-schedule (work hours, lunch, MWF preference, etc.). Assignable per academic year and/or student class.
model SchedulingRuleSet {
  id           String   @id @default(uuid())
  name         String
  description  String?
  config       Json     // workStartMinutes, workEndMinutes, lunchStart/End, slotStep, preferMwf3Unit, maxBlockMinutes, avoidLunchSpan
  departmentId String?  // chairman sees only sets for their department or null (shared)
  isSystem     Boolean  @default(false) // system default; not deletable
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments  SchedulingRuleSetAssignment[]

  @@index([departmentId])
  @@index([isSystem])
}

// Which rule set applies for a given (academic year, student class). Resolution: (year, class) exact > (year, null) > (null, class) > default rule set.
model SchedulingRuleSetAssignment {
  id              String   @id @default(uuid())
  academicYearId   String?
  studentClassId   String?
  ruleSetId        String
  createdAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear  AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentClass  StudentClass?  @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  ruleSet       SchedulingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentClassId])
  @@index([ruleSetId])
  @@index([academicYearId])
  @@index([studentClassId])
}
