// COE.Vantage - Faculty Load Scheduling System
// PostgreSQL with UUID primary keys

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEAN
  CHAIRMAN
  FACULTY
  OFFICER
  COLLEGE_SECRETARY
  PRESIDENT // sees the whole university, read only
  UNIT // a viewer from the university administration: only the colleges and areas the admin grants, read only
}

model User {
  id                   String    @id @default(uuid())
  collegeId            String?
  email                String    @unique
  passwordHash         String
  role                 Role
  departmentId         String?
  name                 String
  experimentalFeatures Json?
  lastSeenVersion      String? // newest release this person has looked at in the notification bell
  unitColleges         String[]  @default([]) // UNIT role: the colleges this viewer may see
  unitAreas            String[]  @default([]) // UNIT role: what they may see in them (ROOMS, SCHEDULES, CURRICULUM, FACULTY, REPORTS)
  status               String? // e.g. Full-time, Part-time (from faculty list)
  maxUnits             Int? // max load units per term (null = no cap)
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  department                       Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyLoads                     FacultyLoad[]
  subjectFacultyPriorities         SubjectFacultyPriority[]
  deloadings                       FacultyDeloading[]
  feedbacks                        Feedback[]
  notifications                    Notification[]
  avatar                           UserAvatar?
  crossDepartmentRequestsRequested CrossDepartmentLoadRequest[] @relation("RequestedBy")
  crossDepartmentRequestsResponded CrossDepartmentLoadRequest[] @relation("RespondedBy")
  crossDepartmentRequestsAsFaculty CrossDepartmentLoadRequest[] @relation("FacultyRequested")
  gradeSubjectsOwned               GradeSubject[]               @relation("GradeSubjectOwner")
  gradeSubjectViewerLinks          GradeSubjectViewer[]
  college                          College?                     @relation(fields: [collegeId], references: [id])

  @@index([role, departmentId])
  @@index([isDeleted])
  @@index([collegeId])
}

// The university holds colleges; every college holds its own departments, people, rooms and schedules.
model University {
  id        String   @id @default(uuid())
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colleges College[]
}

model College {
  id                    String    @id @default(uuid())
  universityId          String
  name                  String
  code                  String?
  /// The term this college is scheduling now; both null = it has not started. Academic years are shared, each college picks its own.
  currentAcademicYearId String?
  currentSemester       Int?
  isDeleted             Boolean   @default(false)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  university          University                   @relation(fields: [universityId], references: [id])
  currentAcademicYear AcademicYear?                @relation("CollegeCurrentYear", fields: [currentAcademicYearId], references: [id], onDelete: SetNull)
  users               User[]
  departments         Department[]
  curricula           Curriculum[]
  subjects            Subject[]
  studentClasses      StudentClass[]
  rooms               Room[]
  facultyLoads        FacultyLoad[]
  ruleSets            SchedulingRuleSet[]
  geOfferingSets      GeOfferingSet[]
  termLocks           TermLock[]
  image               CollegeImage?
  requests            CrossDepartmentLoadRequest[]

  @@index([universityId])
}

model Department {
  id        String    @id @default(uuid())
  collegeId String?
  name      String
  code      String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users              User[]
  rooms              Room[]
  roomsControlled    Room[]              @relation("ControlDepartment")
  curricula          Curriculum[]
  subjects           Subject[]
  gradeSubjects      GradeSubject[]
  schedulingRuleSets SchedulingRuleSet[]
  college            College?            @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([isDeleted])
  @@index([collegeId])
}

model GradeSubject {
  id                    String    @id @default(uuid())
  name                  String
  code                  String?
  ownerId               String
  departmentId          String?
  gradingSystem         Json?
  studentComputeEnabled Boolean   @default(false)
  isDeleted             Boolean   @default(false)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner      User                 @relation("GradeSubjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  department Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  viewers    GradeSubjectViewer[]
  records    GradeRecord[]

  @@index([ownerId, isDeleted])
  @@index([departmentId])
}

model GradeSubjectViewer {
  id        String   @id @default(uuid())
  subjectId String
  userId    String
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  subject GradeSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectId, userId])
  @@index([userId])
}

model GradeRecord {
  id            String    @id @default(uuid())
  subjectId     String
  studentName   String
  studentNumber String
  email         String?
  code          String
  grades        Json
  maxScores     Json?
  computedGrade Json?
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subject GradeSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([studentNumber, code])
}

model Room {
  id                  String    @id @default(uuid())
  collegeId           String?
  name                String
  capacity            Int
  hasComputer         Boolean   @default(false)
  isLab               Boolean   @default(false)
  hasAC               Boolean   @default(false)
  departmentId        String
  controlDepartmentId String? // department that controls assignment; when closed, only they can assign
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  department                  Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  controlDepartment           Department?                  @relation("ControlDepartment", fields: [controlDepartmentId], references: [id], onDelete: SetNull)
  facultyLoads                FacultyLoad[]
  termAvailability            RoomTermAvailability[]
  subjectRooms                SubjectRoom[]
  crossDepartmentLoadRequests CrossDepartmentLoadRequest[]
  college                     College?                     @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([departmentId, isLab, capacity])
  @@index([controlDepartmentId])
  @@index([isDeleted])
  @@index([collegeId])
}

model AcademicYear {
  id              String    @id @default(uuid())
  name            String // e.g. "2025-2026"
  isActive        Boolean   @default(false)
  currentSemester Int       @default(1) // 1 = 1st, 2 = 2nd, 3 = Mid Year; the default semester while this year is the active one
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  facultyLoads                 FacultyLoad[]
  roomTermAvailability         RoomTermAvailability[]
  crossDepartmentRequests      CrossDepartmentLoadRequest[]
  schedulingRuleSetAssignments SchedulingRuleSetAssignment[]
  subjectFacultyPriorities     SubjectFacultyPriority[]
  deloadings                   FacultyDeloading[]
  geOfferingSets               GeOfferingSet[]
  termLocks                    TermLock[]
  collegesCurrent              College[]                     @relation("CollegeCurrentYear")

  @@index([isDeleted])
}

model Curriculum {
  id           String    @id @default(uuid())
  collegeId    String?
  name         String
  code         String?
  departmentId String?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subjects       Subject[]
  studentClasses StudentClass[]
  college        College?       @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([isDeleted])
  @@index([collegeId])
}

model Subject {
  id           String    @id @default(uuid())
  collegeId    String?
  code         String
  name         String
  units        Int // total units: lecUnits + labUnits (the curriculum checklist figure)
  lecUnits     Int       @default(0) // lecture units, 1 hour/week each
  labUnits     Int       @default(0) // laboratory units, 3 hours/week each; faculty load credit = lecUnits + 3 * labUnits
  isLab        Boolean   @default(false) // pure laboratory subject (no lecture units): needs a laboratory room
  yearLevel    Int? // 1-5
  semester     Int? // 1 = 1st sem, 2 = 2nd sem, 3 = mid year
  curriculumId String?
  departmentId String?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  curriculum                  Curriculum?                  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  department                  Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyLoads                FacultyLoad[]
  subjectFacultyPriorities    SubjectFacultyPriority[]
  subjectRooms                SubjectRoom[]
  crossDepartmentLoadRequests CrossDepartmentLoadRequest[]
  college                     College?                     @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@unique([curriculumId, code])
  @@index([isDeleted])
  @@index([collegeId])
}

model StudentClass {
  id           String    @id @default(uuid())
  collegeId    String?
  name         String // e.g. BSCE-3A
  yearLevel    Int
  curriculumId String
  studentCount Int
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  curriculum                   Curriculum                    @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  facultyLoads                 FacultyLoad[]
  crossDepartmentLoadRequests  CrossDepartmentLoadRequest[]
  schedulingRuleSetAssignments SchedulingRuleSetAssignment[]
  college                      College?                      @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([curriculumId])
  @@index([isDeleted])
  @@index([collegeId])
}

// Per-term room availability: closed = only control dept can assign; open = any dept
model RoomTermAvailability {
  id             String   @id @default(uuid())
  roomId         String
  academicYearId String
  semester       Int // 1 or 2
  isOpen         Boolean  @default(false) // when true, any department can assign
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([roomId, academicYearId, semester])
  @@index([roomId])
  @@index([academicYearId])
}

enum CrossDepartmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Chairman A requests to assign faculty from Dept B; Chairman B approves/rejects
model CrossDepartmentLoadRequest {
  id              String                       @id @default(uuid())
  collegeId       String?
  requestedById   String
  facultyId       String
  subjectId       String
  studentClassId  String
  roomId          String? // nullable for off-system room
  roomDisplayName String?
  dayOfWeek       Int
  startTime       String
  endTime         String
  semester        Int
  academicYearId  String
  status          CrossDepartmentRequestStatus @default(PENDING)
  respondedById   String?
  respondedAt     DateTime?
  notes           String?
  replacesLoadId  String? // when set, approval replaces this existing load (faculty change on edit)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  requestedBy  User         @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  faculty      User         @relation("FacultyRequested", fields: [facultyId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentClass StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  respondedBy  User?        @relation("RespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  college      College?     @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([facultyId])
  @@index([academicYearId])
  @@index([status])
  @@index([collegeId])
}

// dayOfWeek: 1 = Monday, 7 = Saturday (ISO); or 0-6 in some systems - we use 1-7
// startTime/endTime: "HH:mm" e.g. "08:00", "09:30"
// facultyId/roomId optional for "Others" faculty and off-system room; use facultyDisplayName/roomDisplayName when null
model FacultyLoad {
  id                 String   @id @default(uuid())
  collegeId          String?
  facultyId          String? // null = off-system faculty (use facultyDisplayName)
  facultyDisplayName String?
  subjectId          String
  studentClassId     String
  roomId             String? // null = off-system room (use roomDisplayName)
  roomDisplayName    String?
  dayOfWeek          Int // 1 = Mon .. 7 = Sat (or 0-6; we use 1-7 for display)
  startTime          String // "HH:mm"
  endTime            String // "HH:mm"
  semester           Int // 1 or 2
  academicYearId     String
  isSplit            Boolean  @default(false) // the class is split between instructors for this subject (see facultyLoadService)
  hostCollegeId      String? // set when the room belongs to another college (an approved room request); the room's college can see the block
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  faculty      User?        @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentClass StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  college      College?     @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([facultyId])
  @@index([roomId])
  @@index([studentClassId])
  @@index([academicYearId])
  @@index([roomId, dayOfWeek, academicYearId, semester])
  @@index([facultyId, dayOfWeek, academicYearId, semester])
  @@index([studentClassId, dayOfWeek, academicYearId, semester])
  @@index([collegeId])
  @@index([hostCollegeId])
}

/// Per-term reduction of a person's maximum units (designations, research, admin work). Effective max = maxUnits - sum(units).
model FacultyDeloading {
  id             String   @id @default(uuid())
  userId         String
  academicYearId String
  semester       Int
  description    String
  units          Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([userId, academicYearId, semester])
  @@index([academicYearId, semester])
}

/// Rooms a subject is restricted to when auto-assign picks a room. No rows = any available room.
model SubjectRoom {
  id        String   @id @default(uuid())
  subjectId String
  roomId    String
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([subjectId, roomId])
  @@index([subjectId])
  @@index([roomId])
}

model SubjectFacultyPriority {
  id             String   @id @default(uuid())
  subjectId      String
  facultyId      String
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  /// Term this "possible subject to teach" applies to. Null = legacy row from before terms existed (ignored).
  academicYearId String?
  semester       Int?

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty      User          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([subjectId, facultyId, academicYearId, semester])
  @@index([subjectId])
  @@index([facultyId])
  @@index([academicYearId, semester])
}

// Configurable rule set for auto-schedule (work hours, lunch, MWF preference, etc.). Assignable per academic year and/or student class.
model SchedulingRuleSet {
  id           String   @id @default(uuid())
  collegeId    String?
  name         String
  description  String?
  config       Json // workStartMinutes, workEndMinutes, lunchStart/End, slotStep, preferMwf3Unit, maxBlockMinutes, avoidLunchSpan
  departmentId String? // chairman sees only sets for their department or null (shared)
  isSystem     Boolean  @default(false) // system default; not deletable
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department  Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments SchedulingRuleSetAssignment[]
  college     College?                      @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([isSystem])
  @@index([collegeId])
}

// Which rule set applies for a given (academic year, student class). Resolution: (year, class) exact > (year, null) > (null, class) > default rule set.
model SchedulingRuleSetAssignment {
  id             String   @id @default(uuid())
  academicYearId String?
  studentClassId String?
  ruleSetId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentClass StudentClass?     @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  ruleSet      SchedulingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentClassId])
  @@index([ruleSetId])
  @@index([academicYearId])
  @@index([studentClassId])
}

enum FeedbackType {
  BUG
  CHANGE
  IDEA
}

enum FeedbackStatus {
  NEW
  PLANNED
  DONE
  DECLINED
}

// Review / feedback submitted by any user; only admins change status or notes.
model Feedback {
  id          String         @id @default(uuid())
  userId      String
  page        String // page or section the feedback is about
  type        FeedbackType
  title       String
  description String
  status      FeedbackStatus @default(NEW)
  adminNote   String?
  archivedAt  DateTime? // archived items are hidden from the default list
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images FeedbackImage[]

  @@index([status, archivedAt])
  @@index([createdAt])
  @@index([userId])
}

// A person's picture, kept in the database like feedback pictures. Its own table so user lists never load the bytes.
model UserAvatar {
  userId    String   @id
  mimeType  String
  size      Int
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The card picture of a college, shown on the university overview.
model CollegeImage {
  collegeId String   @id
  mimeType  String
  size      Int
  data      Bytes
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

// A college asking another college for the use of its rooms, after the other college locked its semester.
// Flow: chairmen draft blocks (RoomShareBlock with no request), their college secretary submits them as a request, the chairman
// of each room's department approves, then the host college secretary approves last and the blocks become schedule blocks.
// The host dean only views and is notified. Ids only (no foreign keys): the rows are read across colleges by the service.
model RoomShareRequest {
  id              String    @id @default(uuid())
  guestCollegeId  String
  hostCollegeId   String
  academicYearId  String
  semester        Int
  status          String    @default("PENDING_CHAIRMAN") // PENDING_CHAIRMAN, PENDING_SECRETARY, APPROVED, REJECTED, CANCELLED
  note            String?
  submittedById   String?
  submittedByName String
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNotes   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  blocks    RoomShareBlock[]
  approvals RoomShareApproval[]

  @@index([guestCollegeId, status])
  @@index([hostCollegeId, status])
}

model RoomShareBlock {
  id             String   @id @default(uuid())
  requestId      String? // null while it is only a draft
  guestCollegeId String
  hostCollegeId  String
  roomId         String
  academicYearId String
  semester       Int
  studentClassId String
  subjectId      String
  facultyId      String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  createdById    String
  createdByName  String
  createdAt      DateTime @default(now())

  request RoomShareRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([guestCollegeId, requestId])
  @@index([roomId, academicYearId, semester])
}

// One chairman approval per department that owns a requested room.
model RoomShareApproval {
  id             String    @id @default(uuid())
  requestId      String
  departmentId   String
  departmentName String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedById    String?
  decidedByName  String?
  decidedAt      DateTime?
  notes          String?

  request RoomShareRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, departmentId])
}

// Append-only history of changes to core records, for accountability. The person is copied into the entry (name, email,
// role, department) and actorId has no foreign key, so entries stay as they were when a user changes role or is removed.
model AuditLog {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  actorId           String?
  actorName         String
  actorEmail        String?
  actorRole         String
  actorDepartmentId String?
  entityType        String // ACADEMIC_YEAR, CURRICULUM, SUBJECT, STUDENT_CLASS, DEPARTMENT, ROOM, USER, SCHEDULING_RULE, SCHEDULE_BLOCK, GE_SHEET, DELOADING
  entityId          String?
  entityLabel       String? // name of the record at that time
  action            String
  summary           String
  changes           Json? // { field: { from, to } }
  academicYearId    String?
  semester          Int?
  collegeId         String? // college the record belongs to; null = university level

  @@index([createdAt])
  @@index([collegeId])
  @@index([entityType, createdAt])
  @@index([entityId])
  @@index([actorId])
}

// A locked semester takes no scheduling changes until it is unlocked (see utils/termLock.ts).
model TermLock {
  id             String   @id @default(uuid())
  collegeId      String?
  academicYearId String
  semester       Int // 1 = 1st, 2 = 2nd, 3 = Mid Year
  lockedByName   String // who locked it, kept as text so it survives account changes
  lockedAt       DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  college      College?     @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@unique([collegeId, academicYearId, semester])
  @@index([collegeId])
}

// Bell notification for one user. Events of one kind fold into a single unread row (groupKey, count).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // SCHEDULE, DELOADING, REQUEST, REQUEST_RESULT, FEEDBACK, TERM, GE_SHEET ...
  title     String
  body      String?
  link      String? // app route the notification opens
  groupKey  String?
  count     Int       @default(1)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, updatedAt])
}

// Screenshot stored in the database. Kept in its own table so lists never load the bytes; can be purged to limit size.
model FeedbackImage {
  id         String   @id @default(uuid())
  feedbackId String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([createdAt])
}

/// The college-wide GE course offering sheet of one term, uploaded by the college secretary. Chairmen import their classes from it.
model GeOfferingSet {
  id             String   @id @default(uuid())
  collegeId      String?
  academicYearId String
  semester       Int
  rows           Json // parsed rows (see geParser.ts)
  rowCount       Int
  sourceName     String?
  uploadedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  college      College?     @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@unique([collegeId, academicYearId, semester])
  @@index([collegeId])
}
